# MoMoTrack Oracle configuration (copy to .env — never commit .env)

# Safrochain network: safrochain-testnet | safrochain-mainnet
MOMOTRACK_NETWORK=safrochain-testnet

# Oracle service endpoint
MOMOTRACK_ORACLE_URL=https://oracle.testnet.momotrack.safrochain.com

# Mobile Money provider: powerpay | cotanipay | <custom-adapter>
MOMOTRACK_PROVIDER=powerpay

# Provider credentials (server-side only — do not expose in client apps)
PROVIDER_API_KEY=
PROVIDER_WEBHOOK_SECRET=

# Optional: Safrochain RPC for on-chain verification
SAFROCHAIN_RPC_URL=https://rpc.testnet.safrochain.com
